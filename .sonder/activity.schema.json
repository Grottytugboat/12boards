{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sonder generated Git activity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "repository",
    "ref",
    "headSha",
    "headUrl",
    "committedAt",
    "subject",
    "actor",
    "changedFiles",
    "recordedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^refs/heads/.+"
    },
    "headSha": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "headUrl": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 2048,
      "format": "uri"
    },
    "committedAt": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 27,
      "format": "date-time"
    },
    "subject": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "actor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 160
    },
    "changedFiles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "recordedAt": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 27,
      "format": "date-time"
    }
  }
}
