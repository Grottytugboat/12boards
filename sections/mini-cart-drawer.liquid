<!-- Mini Cart Drawer - Backcountry/Gymshark Style -->
<div class="mini-cart-overlay" id="mini-cart-overlay">
  <div class="mini-cart-drawer" id="mini-cart-drawer">
    
    <!-- Header -->
    <div class="mini-cart-header">
      <h3 class="mini-cart-title">
        Cart (<span id="cart-item-count">{{ cart.item_count }}</span>)
      </h3>
      <button class="mini-cart-close" onclick="closeMiniCart()" aria-label="Close cart">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <!-- Empty State -->
    {% if cart.item_count == 0 %}
    <div class="mini-cart-empty">
      <div class="empty-cart-icon">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none">
          <path d="M3 3H5L5.4 5M7 13H17L21 5H5.4M7 13L5.4 5M7 13L4.7 15.3C4.3 15.7 4.6 16.5 5.1 16.5H17M17 13V17C17 18.1 16.1 19 15 19H9C7.9 19 7 18.1 7 17V13M17 13H7" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </div>
      <p class="empty-cart-text">Your cart is empty</p>
      <button class="btn-secondary" onclick="closeMiniCart()">Continue Shopping</button>
    </div>
    {% else %}

    <!-- Shipping Progress -->
    <div class="shipping-progress">
      {% assign free_shipping_threshold = 100.00 %}
      {% assign remaining_amount = free_shipping_threshold | minus: cart.total_price | divided_by: 100.0 %}
      {% if remaining_amount > 0 %}
        {% assign progress_percentage = cart.total_price | divided_by: 100.0 | divided_by: free_shipping_threshold | times: 100 %}
        <div class="shipping-bar">
          <div class="shipping-progress-fill" style="width: {{ progress_percentage }}%"></div>
        </div>
        <p class="shipping-text">
          Add <strong>${{ remaining_amount | money_without_currency }}</strong> more for free shipping
        </p>
      {% else %}
        <div class="shipping-unlocked">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path d="M9 12L11 14L15 10M21 12C21 16.97 16.97 21 12 21C7.03 21 3 16.97 3 12C3 7.03 7.03 3 12 3C16.97 3 21 7.03 21 12Z" stroke="#22c55e" stroke-width="2"/>
          </svg>
          <span>You've unlocked free shipping!</span>
        </div>
      {% endif %}
    </div>

    <!-- Cart Items -->
    <div class="mini-cart-items">
      {% for item in cart.items %}
      <div class="cart-item" data-key="{{ item.key }}">
        
        <!-- Product Image -->
        <div class="item-image">
          <img src="{{ item.image | img_url: '100x100' }}" alt="{{ item.title }}" loading="lazy">
        </div>

        <!-- Product Details -->
        <div class="item-details">
          <h4 class="item-title">{{ item.product.title }}</h4>
          {% if item.variant.title != 'Default Title' %}
            <p class="item-variant">{{ item.variant.title }}</p>
          {% endif %}
          
          <!-- Quantity & Price -->
          <div class="item-controls">
            <div class="quantity-controls">
              <button class="qty-btn" onclick="updateQuantity('{{ item.key }}', {{ item.quantity | minus: 1 }})" 
                      {{ item.quantity | minus: 1 | at_most: 0 == 0 ? 'disabled' : '' }}>
                <svg width="12" height="12" viewBox="0 0 24 24"><path d="M5 12H19" stroke="currentColor" stroke-width="2"/></svg>
              </button>
              <span class="qty-display">{{ item.quantity }}</span>
              <button class="qty-btn" onclick="updateQuantity('{{ item.key }}', {{ item.quantity | plus: 1 }})">
                <svg width="12" height="12" viewBox="0 0 24 24"><path d="M12 5V19M5 12H19" stroke="currentColor" stroke-width="2"/></svg>
              </button>
            </div>
            
            <div class="item-pricing">
              {% if item.original_line_price != item.final_line_price %}
                <span class="item-price-original">${{ item.original_line_price | money_without_currency }}</span>
              {% endif %}
              <span class="item-price">${{ item.final_line_price | money_without_currency }}</span>
            </div>
          </div>
        </div>

        <!-- Remove Button -->
        <button class="item-remove" onclick="removeItem('{{ item.key }}')" aria-label="Remove item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path d="M3 6H5H21M8 6V4C8 3.4 8.4 3 9 3H15C15.6 3 16 3.4 16 4V6M19 6V20C19 20.6 18.6 21 18 21H6C5.4 21 5 20.6 5 20V6H19Z" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </button>
      </div>
      {% endfor %}
    </div>

    <!-- Cart Summary -->
    <div class="mini-cart-footer">
      
      <!-- Trust Signals -->
      <div class="trust-signals">
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path d="M12 2L3 7L12 12L21 7L12 2Z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M3 17L12 22L21 17" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span>Free shipping over $100</span>
        </div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path d="M9 12L11 14L15 10M21 12C21 16.97 16.97 21 12 21C7.03 21 3 16.97 3 12C3 7.03 7.03 3 12 3C16.97 3 21 7.03 21 12Z" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span>30-day returns</span>
        </div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
            <path d="M12 1L15.09 8.26L23 9L17 14.74L18.18 22.02L12 18.77L5.82 22.02L7 14.74L1 9L8.91 8.26L12 1Z" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span>Secure checkout</span>
        </div>
      </div>

      <!-- Subtotal -->
      <div class="cart-subtotal">
        <div class="subtotal-row">
          <span>Subtotal</span>
          <span class="subtotal-price">${{ cart.total_price | money_without_currency }}</span>
        </div>
        {% if cart.total_discounts > 0 %}
        <div class="savings-row">
          <span>You save</span>
          <span class="savings-amount">-${{ cart.total_discounts | money_without_currency }}</span>
        </div>
        {% endif %}
        <p class="shipping-note">Shipping calculated at checkout</p>
      </div>

      <!-- BNPL Options -->
      <div class="bnpl-options">
        <p class="bnpl-text">
          or 4 interest-free payments of 
          <strong>${{ cart.total_price | divided_by: 4 | money_without_currency }}</strong>
        </p>
        <div class="bnpl-logos">
          <span class="bnpl-logo">Afterpay</span>
          <span class="bnpl-logo">Zip</span>
        </div>
      </div>

      <!-- Checkout Button -->
      <button class="checkout-btn" onclick="window.location.href='/checkout'">
        Secure Checkout
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2"/>
        </svg>
      </button>

      <!-- Continue Shopping -->
      <button class="continue-shopping" onclick="closeMiniCart()">
        Continue Shopping
      </button>
    </div>

    {% endif %}
  </div>
</div>

<style>
/* Mini Cart Overlay */
.mini-cart-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.mini-cart-overlay.active {
  opacity: 1;
  visibility: visible;
}

/* Mini Cart Drawer */
.mini-cart-drawer {
  position: fixed;
  top: 0;
  right: 0;
  height: 100vh;
  width: 100%;
  max-width: 420px;
  background: white;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.3s ease;
  box-shadow: -4px 0 20px rgba(0, 0, 0, 0.15);
}

.mini-cart-overlay.active .mini-cart-drawer {
  transform: translateX(0);
}

/* Header */
.mini-cart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 24px;
  border-bottom: 1px solid #e5e7eb;
  background: #fafafa;
}

.mini-cart-title {
  font-size: 18px;
  font-weight: 600;
  margin: 0;
  color: #111;
}

.mini-cart-close {
  background: none;
  border: none;
  padding: 8px;
  cursor: pointer;
  color: #666;
  border-radius: 6px;
  transition: background-color 0.2s;
}

.mini-cart-close:hover {
  background: #f3f4f6;
}

/* Empty State */
.mini-cart-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 24px;
  text-align: center;
  flex: 1;
}

.empty-cart-icon {
  color: #d1d5db;
  margin-bottom: 16px;
}

.empty-cart-text {
  font-size: 16px;
  color: #6b7280;
  margin: 0 0 24px 0;
}

/* Shipping Progress */
.shipping-progress {
  padding: 16px 24px;
  background: #f8fafc;
  border-bottom: 1px solid #e5e7eb;
}

.shipping-bar {
  width: 100%;
  height: 4px;
  background: #e5e7eb;
  border-radius: 2px;
  overflow: hidden;
  margin-bottom: 8px;
}

.shipping-progress-fill {
  height: 100%;
  background: #22c55e;
  transition: width 0.3s ease;
}

.shipping-text {
  font-size: 14px;
  color: #374151;
  margin: 0;
  text-align: center;
}

.shipping-unlocked {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  color: #22c55e;
  font-size: 14px;
  font-weight: 500;
}

/* Cart Items */
.mini-cart-items {
  flex: 1;
  padding: 16px 0;
  overflow-y: auto;
}

.cart-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 24px;
  border-bottom: 1px solid #f3f4f6;
}

.cart-item:last-child {
  border-bottom: none;
}

.item-image img {
  width: 60px;
  height: 60px;
  object-fit: cover;
  border-radius: 6px;
  background: #f9fafb;
}

.item-details {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 14px;
  font-weight: 500;
  color: #111;
  margin: 0 0 4px 0;
  line-height: 1.3;
}

.item-variant {
  font-size: 13px;
  color: #6b7280;
  margin: 0 0 8px 0;
}

.item-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quantity-controls {
  display: flex;
  align-items: center;
  gap: 8px;
}

.qty-btn {
  width: 28px;
  height: 28px;
  border: 1px solid #e5e7eb;
  background: white;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
}

.qty-btn:hover:not(:disabled) {
  border-color: #d1d5db;
  background: #f9fafb;
}

.qty-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.qty-display {
  font-size: 14px;
  font-weight: 500;
  min-width: 20px;
  text-align: center;
}

.item-pricing {
  text-align: right;
}

.item-price-original {
  font-size: 13px;
  color: #9ca3af;
  text-decoration: line-through;
  display: block;
}

.item-price {
  font-size: 14px;
  font-weight: 600;
  color: #111;
}

.item-remove {
  background: none;
  border: none;
  padding: 6px;
  cursor: pointer;
  color: #9ca3af;
  border-radius: 4px;
  transition: all 0.2s;
}

.item-remove:hover {
  color: #ef4444;
  background: #fef2f2;
}

/* Footer */
.mini-cart-footer {
  padding: 20px 24px 24px;
  border-top: 1px solid #e5e7eb;
  background: white;
}

.trust-signals {
  display: grid;
  gap: 8px;
  margin-bottom: 20px;
}

.trust-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: #6b7280;
}

.trust-item svg {
  color: #22c55e;
}

.cart-subtotal {
  margin-bottom: 16px;
}

.subtotal-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}

.subtotal-row span:first-child {
  font-size: 16px;
  font-weight: 500;
  color: #111;
}

.subtotal-price {
  font-size: 18px;
  font-weight: 600;
  color: #111;
}

.savings-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.savings-row span:first-child {
  font-size: 14px;
  color: #059669;
}

.savings-amount {
  font-size: 14px;
  font-weight: 500;
  color: #059669;
}

.shipping-note {
  font-size: 13px;
  color: #6b7280;
  margin: 0;
}

.bnpl-options {
  text-align: center;
  margin-bottom: 20px;
  padding: 12px;
  background: #f8fafc;
  border-radius: 8px;
}

.bnpl-text {
  font-size: 13px;
  color: #374151;
  margin: 0 0 8px 0;
}

.bnpl-logos {
  display: flex;
  justify-content: center;
  gap: 12px;
}

.bnpl-logo {
  font-size: 11px;
  font-weight: 600;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.checkout-btn {
  width: 100%;
  background: #111;
  color: white;
  border: none;
  padding: 16px;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 12px;
}

.checkout-btn:hover {
  background: #000;
}

.continue-shopping {
  width: 100%;
  background: none;
  color: #6b7280;
  border: 1px solid #e5e7eb;
  padding: 12px;
  border-radius: 8px;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s;
}

.continue-shopping:hover {
  border-color: #d1d5db;
  color: #374151;
}

.btn-secondary {
  background: #f3f4f6;
  color: #374151;
  border: none;
  padding: 12px 24px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: background-color 0.2s;
}

.btn-secondary:hover {
  background: #e5e7eb;
}

/* Mobile Responsiveness */
@media (max-width: 480px) {
  .mini-cart-drawer {
    max-width: 100%;
  }
  
  .cart-item {
    padding: 12px 16px;
  }
  
  .mini-cart-header,
  .mini-cart-footer {
    padding-left: 16px;
    padding-right: 16px;
  }
  
  .shipping-progress {
    padding: 12px 16px;
  }
}
</style>